# Если ноутбук включили в режиме Eco, BIOS оставляет на шине PCI обесточенную NVIDIA,
# и ядро ждёт её по 65 с при каждом выходе из сна. Убираем её при загрузке и перед каждым сном.
# Когда NVIDIA включена, gpu-eco fixup ничего не делает.
[Unit]
Description=gpu-eco: убрать выключенную NVIDIA с шины PCI (быстрый выход из сна)
After=systemd-modules-load.service systemd-udevd.service
Before=sleep.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gpu-eco fixup
# gpu-eco сам пишет в журнал через logger, вывод не нужен (иначе строки дублируются)
StandardOutput=null

[Install]
WantedBy=multi-user.target sleep.target
