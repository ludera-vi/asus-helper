#!/bin/bash
# prime-run из gpu-switch — запуск программы на NVIDIA.
# Снимает «по умолчанию встроенная видеокарта» из ~/.config/environment.d/91-igpu-apps.conf.
# Если NVIDIA выключена (gpu-eco off), программа запустится на встроенной видеокарте.

if [ "$(gpu-eco state 2>/dev/null)" = off ]; then
    msg="NVIDIA выключена — «$(basename "${1:-программа}")» запущена на встроенной видеокарте. Включить: gpu-eco on"
    echo "$msg" >&2
    command -v notify-send >/dev/null && notify-send -a "NVIDIA Eco" -i video-display NVIDIA "$msg"
    exec "$@"
fi

unset __EGL_VENDOR_LIBRARY_FILENAMES VK_DRIVER_FILES
export __NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only __GLX_VENDOR_LIBRARY_NAME=nvidia
exec "$@"
