#!/bin/bash
# gpu-eco — полное отключение NVIDIA через BIOS (как Eco в G-Helper) и возврат в гибрид, без перезагрузки.
#   gpu-eco status        — подробное состояние (карту не будит)
#   gpu-eco state         — одно слово для значка на панели (без root)
#   gpu-eco who           — какие твои программы сейчас используют NVIDIA (без root)
#   gpu-eco off [--force] — выключить NVIDIA; --force закрывает программы, которые её используют
#   gpu-eco on            — включить NVIDIA обратно (гибридный режим)
#   gpu-eco fixup         — убрать с шины выключенную в BIOS карту (запускает gpu-eco-fixup.service)
# Флаг BIOS сохраняется после перезагрузки. Журнал: journalctl -t gpu-eco

set -uo pipefail

ATTR=/sys/class/firmware-attributes/asus-armoury/attributes
if [ -e "$ATTR/dgpu_disable/current_value" ]; then
    DGPU=$ATTR/dgpu_disable/current_value    # 1 = NVIDIA выключена в BIOS
    MUX=$ATTR/gpu_mux_mode/current_value     # 1 = гибрид (Optimus), 0 = только NVIDIA
else
    DGPU=/sys/devices/platform/asus-nb-wmi/dgpu_disable   # старые ядра
    MUX=/sys/devices/platform/asus-nb-wmi/gpu_mux_mode
fi
PCI=/sys/bus/pci/devices
SERVICES=(nvidia-powerd nvidia-persistenced)
MODULES=(nvidia_drm nvidia_modeset nvidia_uvm nvidia)

log() { echo "$*"; logger -t gpu-eco -- "$*"; }
die() { log "ОШИБКА: $*"; exit 1; }

# PCI-адрес видеокарты NVIDIA; пусто, если её нет на шине
find_gpu() {
    local d
    for d in "$PCI"/*; do
        if [ "$(cat "$d/vendor")" = 0x10de ] && [[ "$(cat "$d/class")" == 0x03* ]]; then
            basename "$d"; return
        fi
    done
}
GPU=$(find_gpu)

# Процессы, которые держат NVIDIA (кроме её собственных сервисов)
holders() {
    [ -n "$GPU" ] || return 0
    local nodes=() n p fd target comm
    for n in /dev/nvidia*; do [ -e "$n" ] && nodes+=("$n"); done
    if [ -d "$PCI/$GPU/drm" ]; then
        for n in "$PCI/$GPU/drm"/*; do nodes+=("/dev/dri/$(basename "$n")"); done
    fi
    [ ${#nodes[@]} -gt 0 ] || return 0
    for p in /proc/[0-9]*; do
        comm=$(cat "$p/comm" 2>/dev/null) || continue
        case "$comm" in nvidia-powerd|nvidia-persistenced) continue ;; esac
        for fd in "$p"/fd/*; do
            target=$(readlink "$fd" 2>/dev/null) || continue
            for n in "${nodes[@]}"; do
                if [ "$target" = "$n" ]; then echo "${p#/proc/} $comm"; continue 3; fi
            done
        done
    done
}

start_services() {
    local s
    for s in "${SERVICES[@]}"; do
        systemctl is-enabled -q "$s" 2>/dev/null && systemctl start "$s"
    done
}

load_driver() {
    modprobe -a nvidia nvidia_modeset nvidia_drm nvidia_uvm
}

# Убирает NVIDIA с шины PCI: сначала звук/USB-C (.1, .2 …), потом саму видеокарту (.0)
remove_from_bus() {
    local f
    for f in $(printf '%s\n' "$PCI/${GPU%.*}".* | sort -r); do
        [ -e "$f/remove" ] && echo 1 > "$f/remove"
    done
}

# Если ноутбук включили в Eco, BIOS всё равно показывает карту на шине, но без питания.
# Такой «призрак» не отвечает, и ядро ждёт его по 65 с при каждом выходе из сна.
# Убираем его, как это делает gpu-eco off. Если карта включена, ничего не делаем.
cmd_fixup() {
    [ "$(cat "$DGPU")" = 1 ] && [ -n "$GPU" ] || return 0
    if [ -e "$PCI/$GPU/driver" ]; then
        log "NVIDIA выключена в BIOS, но драйвер держит карту — не трогаю"; return 0
    fi
    log "Убираю выключенную NVIDIA с шины PCI (иначе выход из сна ждёт её 65 с)"
    remove_from_bus
    GPU=""
}

cmd_state() {
    if [ "$(cat "$DGPU")" = 1 ]; then echo off
    elif [ -n "$GPU" ]; then cat "$PCI/$GPU/power/runtime_status"
    else echo missing
    fi
}

cmd_status() {
    echo "BIOS dgpu_disable : $(cat "$DGPU")   (1 = NVIDIA выключена)"
    [ -e "$MUX" ] && echo "MUX               : $(cat "$MUX")   (1 = гибрид)"
    if [ -n "$GPU" ]; then
        echo "NVIDIA в системе  : да ($GPU), $(cat "$PCI/$GPU/power/runtime_status")"
        [ "$(cat "$DGPU")" = 1 ] && echo "                    выключена в BIOS, но видна на шине — gpu-eco fixup уберёт её"
        echo "Драйвер загружен  : $([ -d /sys/module/nvidia ] && echo да || echo нет)"
        local h; h=$(holders)
        echo "Используют NVIDIA : ${h:-никто}"
    else
        echo "NVIDIA в системе  : нет (отключена)"
    fi
}

cmd_off() {
    local force=${1:-}
    if [ "$(cat "$DGPU")" = 1 ] && [ ! -e "$PCI/$GPU/driver" ]; then
        cmd_fixup; log "NVIDIA уже выключена"; return
    fi
    if [ -e "$MUX" ] && [ "$(cat "$MUX")" = 0 ]; then
        die "MUX в режиме «только NVIDIA» — выключать её нельзя. Переключите MUX в гибрид и перезагрузитесь"
    fi

    if [ -n "$GPU" ]; then
        local busy; busy=$(holders)
        if [ -n "$busy" ]; then
            if [ "$force" != "--force" ]; then
                echo "NVIDIA используют эти программы:"; echo "$busy"
                die "закройте их или запустите: gpu-eco off --force"
            fi
            log "Закрываю программы на NVIDIA: $(echo $busy)"
            echo "$busy" | cut -d' ' -f1 | xargs -r kill -TERM
            sleep 3
            busy=$(holders)
            [ -z "$busy" ] || die "программы не закрылись: $(echo $busy)"
        fi

        log "Останавливаю сервисы NVIDIA"
        systemctl stop "${SERVICES[@]}" 2>/dev/null

        log "Выгружаю драйвер NVIDIA"
        if ! modprobe -r "${MODULES[@]}"; then
            load_driver; start_services
            die "драйвер не выгрузился (что-то ещё использует карту) — всё возвращено как было"
        fi

        log "Убираю NVIDIA с шины PCI"
        remove_from_bus
    fi

    log "Отключаю NVIDIA в BIOS"
    if ! echo 1 > "$DGPU"; then
        echo 1 > /sys/bus/pci/rescan; load_driver; start_services
        die "BIOS отказал в отключении — всё возвращено как было"
    fi
    sleep 1
    [ -z "$(find_gpu)" ] || die "карта всё ещё видна после отключения"
    log "Готово: NVIDIA выключена"
}

cmd_on() {
    if [ "$(cat "$DGPU")" = 0 ] && [ -n "$GPU" ]; then log "NVIDIA уже включена"; return; fi

    # «призрак» на шине помешал бы найти карту заново после включения
    cmd_fixup
    log "Включаю NVIDIA в BIOS"
    echo 0 > "$DGPU" || die "BIOS отказал во включении"

    local i
    for i in $(seq 10); do
        sleep 1
        echo 1 > /sys/bus/pci/rescan
        GPU=$(find_gpu)
        [ -n "$GPU" ] && break
    done
    [ -n "$GPU" ] || die "карта не появилась. Перезагрузите ноутбук — BIOS уже включил её"

    log "Загружаю драйвер NVIDIA"
    load_driver || die "драйвер не загрузился (журнал: journalctl -b -k | grep -i nvidia)"
    start_services
    log "Готово: NVIDIA включена (гибрид)"
}

[ -e "$DGPU" ] || { echo "ОШИБКА: нет $DGPU — это не ноутбук ASUS или ядро без asus-wmi/asus-armoury"; exit 1; }

# Команды без root
case "${1:-status}" in
    state) cmd_state; exit 0 ;;
    who)   holders | cut -d' ' -f2- | sort -u; exit 0 ;;
esac

[ $EUID -eq 0 ] || exec sudo "$0" "$@"

exec 9>/run/gpu-eco.lock
if [ "${1:-}" = fixup ]; then
    flock -w 60 9 || die "gpu-eco занят дольше минуты"   # перед сном — дождаться переключения
else
    flock -n 9 || die "gpu-eco уже выполняется"
fi
GPU=$(find_gpu)   # пока ждали блокировку, другой gpu-eco мог включить или выключить карту

case "${1:-status}" in
    status) cmd_status ;;
    off)    cmd_off "${2:-}" ;;
    on)     cmd_on ;;
    fixup)  cmd_fixup ;;
    *)      echo "Использование: gpu-eco status | state | who | off [--force] | on | fixup"; exit 2 ;;
esac
