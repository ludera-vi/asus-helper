#!/usr/bin/env python3
"""asus-osd — карточки KDE при смене режима (Fn+F5) и подсветки клавиатуры на ноутбуках ASUS.

Режимом управляет asusd, подсветкой — ядро; ни то ни другое не сообщает KDE об изменениях,
поэтому KDE не показывает свои карточки. Этот помощник слушает asusd и следит за подсветкой,
а при изменении вызывает OSD KDE (org.kde.osdService).
"""
import glob
import os

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

# PlatformProfile из asusd → имя профиля для OSD KDE
PROFILES = {0: "balanced", 1: "performance", 2: "power-saver", 3: "power-saver"}

session = Gio.bus_get_sync(Gio.BusType.SESSION)
system = Gio.bus_get_sync(Gio.BusType.SYSTEM)


def osd(method, signature, value):
    session.call(
        "org.kde.plasmashell", "/org/kde/osdService", "org.kde.osdService",
        method, GLib.Variant(signature, (value,)), None,
        Gio.DBusCallFlags.NO_AUTO_START, -1, None, None, None,
    )


# ---------- режим производительности (asusd) ----------
last_profile = None


def read_profile():
    try:
        reply = system.call_sync(
            "xyz.ljones.Asusd", "/xyz/ljones", "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("xyz.ljones.Platform", "PlatformProfile")),
            None, Gio.DBusCallFlags.NONE, -1, None,
        )
        return reply.unpack()[0]
    except GLib.Error:
        return None


def on_asusd_changed(_conn, _sender, _path, _iface, _signal, params):
    global last_profile
    iface, changed, _ = params.unpack()
    if iface != "xyz.ljones.Platform" or "PlatformProfile" not in changed:
        return
    profile = changed["PlatformProfile"]
    if profile != last_profile:  # asusd иногда повторяет то же значение
        last_profile = profile
        osd("powerProfileChanged", "(s)", PROFILES.get(profile, "balanced"))


last_profile = read_profile()
system.signal_subscribe(
    "xyz.ljones.Asusd", "org.freedesktop.DBus.Properties", "PropertiesChanged",
    "/xyz/ljones", None, Gio.DBusSignalFlags.NONE, on_asusd_changed,
)

# ---------- подсветка клавиатуры (ядро) ----------
# Ядро уведомляет об изменении с клавиатуры через brightness_hw_changed (POLLPRI).
# Опрашивать brightness нельзя: на ASUS каждое чтение — вызов BIOS (~3 мс).
kbd = next(iter(glob.glob("/sys/class/leds/*::kbd_backlight")), None)
hw_changed = f"{kbd}/brightness_hw_changed" if kbd else None

if hw_changed and os.path.exists(hw_changed):
    with open(f"{kbd}/max_brightness") as f:
        kbd_max = int(f.read()) or 1
    kbd_fd = os.open(hw_changed, os.O_RDONLY)
    # Без первого чтения poll сработает сразу. Пока после загрузки ни разу не нажали
    # клавишу подсветки, ядро отвечает ENODATA — это нормально: чтение всё равно
    # засчитывается, и poll сработает только при первом нажатии.
    try:
        os.read(kbd_fd, 16)
    except OSError:
        pass

    def on_kbd_changed(fd, _condition):
        os.lseek(fd, 0, os.SEEK_SET)
        try:
            level = int(os.read(fd, 16))
        except (OSError, ValueError):
            return True
        osd("keyboardBrightnessChanged", "(i)", round(level * 100 / kbd_max))
        return True

    GLib.io_add_watch(kbd_fd, GLib.PRIORITY_DEFAULT,
                      GLib.IOCondition.PRI | GLib.IOCondition.ERR, on_kbd_changed)

GLib.MainLoop().run()
