# Maintainer: ludera-vi <aigunichev@gmail.com>
pkgname=asus-helper
pkgver=0.3.1
pkgrel=1
pkgdesc="ASUS ROG/TUF laptop control for KDE Plasma: performance modes, fan curves, power limits, GPU Eco, Aura and Slash lighting (G-Helper-like)"
arch=('any')
url="https://github.com/ludera-vi/asus-helper"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'pyside6' 'polkit' 'systemd' 'libkscreen' 'hwdata'
         'kirigami' 'qqc2-desktop-style' 'layer-shell-qt')
makedepends=('make')
optdepends=('nvidia-utils: NVIDIA load, power and temperature in the window'
            'snapper: snapshot before installing')
# Делают то же самое — вместе с демоном спорили бы за вентиляторы, режимы и видеокарту
conflicts=('asusctl' 'rog-control-center' 'power-profiles-daemon' 'supergfxctl' 'envycontrol' 'nvidia-prime')
provides=('nvidia-prime')
backup=()
install=asus-helper.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
    cd "$pkgname-$pkgver"
    make test
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
