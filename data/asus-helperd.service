[Unit]
Description=Asus-helper — режимы, вентиляторы и подсветка ноутбука ASUS
After=systemd-udevd.service dbus.service
Documentation=https://github.com/ludera-vi/asus-helper
# Делают то же самое — вместе спорили бы за вентиляторы и режимы
Conflicts=asusd.service power-profiles-daemon.service tuned-ppd.service

[Service]
Type=dbus
BusName=org.asushelper.Daemon
ExecStart=@BINDIR@/asus-helperd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Нужен доступ на запись к /sys и /dev/hidraw*, остальное закрыто
ProtectSystem=full
# /etc/asus-helper (настройки) и /var/lib/asus-helper (история) systemd создаёт сам
ConfigurationDirectory=asus-helper
ReadWritePaths=/etc/asus-helper
StateDirectory=asus-helper
# /run/asus-helper/kwin.env — настройка видеокарты для KWin (см. asus-helper-kwin.conf)
RuntimeDirectory=asus-helper
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
